import unittest
from user import is_adult

class TestIsAdult(unittest.TestCase):

    def test_adult_age(self):
        self.assertTrue(is_adult(18))

    def test_underage(self):
        self.assertFalse(is_adult(17))

    def test_negative_age(self):
        # Age cannot be negative; an exception should be thrown instead of returning False.
        with self.assertRaises(ValueError):
            is_adult(-1)

if __name__ == "__main__":
    unittest.main()
